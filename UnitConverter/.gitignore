## .gitignore для C# проекта

# Игнорируем папки сборки
bin/
obj/
.vs/
TestResults/

# Игнорируем файлы пользователей
*.user
*.suo
*.userosscache
*.sln.docstates

# Игнорируем настройки IDE
.vscode/
.idea/

# Игнорируем пакеты NuGet
packages/
*.nupkg
.nuget/

# Игнорируем результаты тестов
*.trx

# Игнорируем временные файлы
_ReSharper*/
*.cache
*.orig
Thumbs.db

# Игнорируем историю чаевых (если создашь)
history.txt